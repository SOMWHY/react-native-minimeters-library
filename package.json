{
  "name": "@minimetermobile/ui",
  "version": "0.1.0",
  "description": "Reusable MiniMeters-style React Native visualization components.",
  "workspaces": [
    "example"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/foundation.test.cjs && node scripts/workspace-smoke.cjs",
    "typecheck:example": "npm run typecheck --workspace=@minimetermobile/ui-example",
    "start:ui-example": "npm start --workspace=@minimetermobile/ui-example",
    "start:ui-storybook": "npm run storybook --workspace=@minimetermobile/ui-example",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-gesture-handler": "~3.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3"
  }
}
