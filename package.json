{
  "name": "@minimetermobile/ui",
  "version": "0.3.2",
  "description": "Reusable MiniMeters-style React Native visualization components.",
  "license": "MIT",
  "author": "SOMWHY",
  "homepage": "https://github.com/SOMWHY/react-native-minimeters-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOMWHY/react-native-minimeters-library.git"
  },
  "bugs": {
    "url": "https://github.com/SOMWHY/react-native-minimeters-library/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "skia",
    "audio",
    "visualizer",
    "spectrum",
    "spectrogram",
    "waveform",
    "vu-meter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "example"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/foundation.test.cjs tests/modules.test.cjs tests/dashboard.test.cjs && node scripts/workspace-smoke.cjs",
    "typecheck:example": "npm run typecheck --workspace=@minimetermobile/ui-example",
    "start:ui-example": "npm start --workspace=@minimetermobile/ui-example",
    "start:ui-storybook": "npm run storybook --workspace=@minimetermobile/ui-example",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.14.0",
    "react": ">=19.0.0",
    "react-native": ">=0.88.1",
    "react-native-gesture-handler": ">=3.3.0",
    "react-native-reanimated": ">=4.7.1",
    "react-native-worklets": ">=0.7.0"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3"
  }
}
